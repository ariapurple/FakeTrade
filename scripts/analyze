#!/usr/bin/env bash
# Run QuantHarness analysis against Longbridge candles.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export LD_LIBRARY_PATH="${HOME}/.local/lib:${LD_LIBRARY_PATH:-}"
PY="${ROOT}/.venv/bin/python"
if [ ! -x "${PY}" ]; then
  PY="${HOME}/.venvs/quantharness/bin/python"
fi
if [ ! -x "${PY}" ]; then
  echo "QuantHarness venv not found. Run scripts/cloud-agent-install.sh" >&2
  exit 1
fi
cd "${ROOT}"
exec "${PY}" -m analysis "$@"
