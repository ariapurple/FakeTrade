          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="g-loop" value="Signal run (only if the gate said yes) — this is the “Longbridge + agent” part" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=2;" vertex="1" parent="1">
