        <mxCell id="agent" value="buy_hold agent&#xa;BUY until live price &lt; SMA200&#xa;then SELL whole long" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="920" y="532" width="220" height="66" as="geometry" />
