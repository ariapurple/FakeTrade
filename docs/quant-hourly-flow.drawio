        <mxCell id="gate2" value="should_place_sim?&#xa;RTH 09:30–16:00 ET" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
