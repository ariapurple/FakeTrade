        <mxCell id="noop" value="No — exit 0&#xa;Longbridge is not called&#xa;no agent, no orders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
