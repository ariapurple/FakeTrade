<mxfile host="app.diagrams.net" agent="Cursor" version="22.1.0">
  <diagram id="quant-hourly" name="Quant hourly 模拟盘">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="How the shared Quant loop runs (Windows PC)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="720" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Longbridge and the buy_hold agent are not always-on daemons. Task Scheduler wakes pythonw every 30 minutes; most wakes exit immediately. OpenD + 牛牛 stay up in the background." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="1100" height="28" as="geometry" />
        </mxCell>

        <mxCell id="g-always" value="Always running on the same PC (not started by the job)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="84" width="1320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="niu" value="富途牛牛 desktop&#xa;logged into 模拟交易&#xa;融資功能設定 = off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="116" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="opend" value="Futu OpenD&#xa;127.0.0.1:11111" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="320" y="116" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lb-auth" value="Longbridge CLI already logged in&#xa;(longbridge auth login)&#xa;no separate background process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="116" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="never" value="Never TrdEnv.REAL&#xa;Never unlock_trade&#xa;Never longbridge --execute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="116" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-niu-opend" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="niu" target="opend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="g-cron" value="Cron-like wake (Windows Task Scheduler, not Linux cron)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="214" width="1320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="task" value="Task QuantFutuSimHourly&#xa;every 30 min on :00 and :30&#xa;hidden pythonw.exe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6c8ebf;fontColor=#ffffff;strokeColor=#1d4e89;" vertex="1" parent="1">
          <mxGeometry x="60" y="246" width="260" height="76" as="geometry" />
        </mxCell>
        <mxCell id="hourly" value="pythonw -m analysis.hourly&#xa;working directory = this repo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="246" width="280" height="76" as="geometry" />
        </mxCell>
        <mxCell id="windows" value="When the job is allowed to work (US Eastern, weekdays)&#xa;Signals: 08:00, 09:00, 09:30–15:30 every 30 min, 16:30&#xa;模拟盘 fills: 09:30–15:30 only (RTH). Other wakes: exit 0, no API calls." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="720" y="246" width="600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="e-task-hourly" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="task" target="hourly">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="gate1" value="should_refresh_signals?&#xa;weekday ET window" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="430" y="370" width="220" height="100" as="geometry" />
