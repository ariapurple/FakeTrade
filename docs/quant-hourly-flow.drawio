          <mxGeometry x="230" y="620" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="sig-idx" value="trading_signal.json&#xa;index only — do not execute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
